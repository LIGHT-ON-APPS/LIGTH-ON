  <Typographies>
    <!--
      운전자가 어두운 환경에서 힐끗 보는 화면이다. 주 수치(RPM)는 다른 어떤
      요소보다 확실히 커야 해서 64 px 을 따로 둔다.

      WildcardCharacters 는 필요한 글자만 남긴다. 폰트 테이블은 크기의 제곱으로
      커져서(64 px 숫자 한 글자가 약 1.3 kB) 쓰지 않는 문자를 넣으면 F411 플래시를
      그냥 버리게 된다. 반대로 여기 없는 문자는 화면에 '?' 로 나오므로, 표시
      코드에서 쓰는 서식 문자를 바꾸면 이 목록도 같이 고쳐야 한다.

      정적 라벨(WildcardCharacters 없는 Label)은 위 Translation 에 실제로 쓰인
      글자만 폰트에 들어간다. 라벨 문구를 바꾸면 반드시 assets 재생성이 필요하다.
    -->
    <Typography Id="Huge" Font="verdana.ttf" Size="64" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacters="0123456789-" />
    <Typography Id="Large" Font="verdana.ttf" Size="40" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacters="0123456789.-" />
    <Typography Id="Tile" Font="verdana.ttf" Size="30" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacters="0123456789.-" />
    <Typography Id="Default" Font="verdana.ttf" Size="20" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacters="0123456789.%-" />
    <Typography Id="Value" Font="verdana.ttf" Size="18" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacters="0123456789.%-" />
    <Typography Id="Label" Font="verdana.ttf" Size="14" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" />
    <Typography Id="Small" Font="verdana.ttf" Size="10" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" />
  </Typographies>
