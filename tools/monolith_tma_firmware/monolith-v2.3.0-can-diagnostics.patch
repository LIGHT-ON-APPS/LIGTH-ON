+/* Parse the hexadecimal CAN ID out of a command topic. Returns 0 for anything
+ * that is not a usable ID; the caller already rejects 0 as invalid.
+ *
+ * atol() read this as decimal, so `.../cmd/can/7FF` transmitted ID 7 rather
+ * than 0x7FF, and a bare `.../cmd/can` reached atol(NULL) and crashed the
+ * device. Keep this in sync with test/test_can_diag.c. */
+static uint32_t can_id_from_token(const char *tok) {
+  if (tok == NULL || *tok == '\0') {
+    return 0;
+  }
+
+  char *end            = NULL;
+  unsigned long parsed = strtoul(tok, &end, 16);
+
+  if (end == NULL || *end != '\0' || parsed > 0x1FFFFFFF) {
+    return 0;
+  }
+
+  return (uint32_t)parsed;
+}
