diff --git a/device/firmware/test/test_can_diag.c b/device/firmware/test/test_can_diag.c
new file mode 100644
index 0000000..d90455c
--- /dev/null
+++ b/device/firmware/test/test_can_diag.c
@@ -0,0 +1,114 @@
+/* Host-side checks for the CAN diagnostics patch. No ESP-IDF, no hardware.
+ *
+ *   gcc -std=c11 -Wall -Wextra -Werror test_can_diag.c -o test_can_diag
+ *   ./test_can_diag
+ *
+ * Two things go wrong quietly. Diagnostic syslog lines are copied into
+ * system_event_t.msg, which is 16 bytes, so a tag that renders longer is cut
+ * and the number it carries becomes unreadable exactly when it matters. And
+ * the command ID parser has to read hex while rejecting the input that used to
+ * transmit the wrong ID or crash the device outright.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define MSG_SIZE 16 /* sizeof(((system_event_t *)0)->msg) in main/main.h */
+
+static int failures = 0;
+
+static void check(int ok, const char *what) {
+  printf("%s %s\n", ok ? "ok  " : "FAIL", what);
+
+  if (!ok) {
+    failures++;
+  }
+}
+
+/* Copy of can_id_from_token() in main/network/mqtt.c. Keep both in sync. */
+static uint32_t can_id_from_token(const char *tok) {
+  if (tok == NULL || *tok == '\0') {
+    return 0;
+  }
+
+  char *end            = NULL;
+  unsigned long parsed = strtoul(tok, &end, 16);
+
+  if (end == NULL || *end != '\0' || parsed > 0x1FFFFFFF) {
+    return 0;
+  }
+
+  return (uint32_t)parsed;
+}
+
+/* snprintf() returns the length it *would* have produced, so anything that
+ * reaches the buffer size was truncated. */
+static void check_fits(const char *what, int written) {
+  if (written < 0 || written >= MSG_SIZE) {
+    printf("FAIL %s (needs %d bytes, buffer is %d)\n", what, written + 1, MSG_SIZE);
+    failures++;
+    return;
+  }
+
+  printf("ok   %s (%d bytes)\n", what, written);
+}
+
+static void test_syslog_tags_fit(void) {
+  char buf[MSG_SIZE];
+
+  /* Every alert bit set at once. */
+  check_fits("CANALT at 0xFFFFFFFF", snprintf(buf, sizeof(buf), "CANALT:%lX", (unsigned long)0xFFFFFFFFUL));
+  check_fits("CANRPT at 0xFFFFFFFF", snprintf(buf, sizeof(buf), "CANRPT:%lX", (unsigned long)0xFFFFFFFFUL));
+
+  /* TWAI error counters are the SJA1000-compatible 8-bit registers, so 255 is
+   * the widest they get even though ESP-IDF reports them as uint32_t. State is
+   * one of the four twai_state_t values. */
+  check_fits("CANEC at 255/255/3", snprintf(buf, sizeof(buf), "CANEC:%02lX/%02lX/%d", 255UL, 255UL, 3));
+
+  /* These are free-running 32-bit counters. */
+  check_fits("CANBE at 0xFFFFFFFF", snprintf(buf, sizeof(buf), "CANBE:%lX", (unsigned long)0xFFFFFFFFUL));
+  check_fits("CANMS at 0xFFFFFFFF", snprintf(buf, sizeof(buf), "CANMS:%lX", (unsigned long)0xFFFFFFFFUL));
+  check_fits("CANOV at 0xFFFFFFFF", snprintf(buf, sizeof(buf), "CANOV:%lX", (unsigned long)0xFFFFFFFFUL));
+
+  /* Fixed strings go through SYSLOG() directly, which strncpy()s 16 bytes. */
+  static const char *const fixed[] = { "CANBOFF:REC", "CANBOFF:ERR", "CANBOFF:UP", "CANBOFF:DOWN" };
+
+  for (size_t i = 0; i < sizeof(fixed) / sizeof(fixed[0]); i++) {
+    char label[64];
+    snprintf(label, sizeof(label), "fixed tag %s", fixed[i]);
+    check(strlen(fixed[i]) <= MSG_SIZE, label);
+  }
+}
+
+static void test_can_id_parsing(void) {
+  /* The case that made the 2026-08-18 bench test meaningless: atol("7FF")
+   * returned 7, so the device transmitted ID 7 and the log read CANTX:7. */
+  check(can_id_from_token("7FF") == 0x7FF, "7FF parses as 0x7FF, not 7");
+  check(can_id_from_token("7ff") == 0x7FF, "lowercase hex accepted");
+  check(can_id_from_token("6B0") == 0x6B0, "BMS frame id");
+  check(can_id_from_token("1838F380") == 0x1838F380UL, "29-bit TEM id");
+  check(can_id_from_token("1FFFFFFF") == 0x1FFFFFFFUL, "widest extended id");
+
+  /* A bare `.../cmd/can` left dir[3] NULL and atol(NULL) faulted the device. */
+  check(can_id_from_token(NULL) == 0, "NULL token rejected instead of crashing");
+  check(can_id_from_token("") == 0, "empty token rejected");
+  check(can_id_from_token("12G") == 0, "trailing junk rejected");
+  check(can_id_from_token("zz") == 0, "non-hex rejected");
+  check(can_id_from_token("20000000") == 0, "id above 29 bits rejected");
+  check(can_id_from_token("0") == 0, "zero stays invalid, as before");
+}
+
+int main(void) {
+  test_syslog_tags_fit();
+  test_can_id_parsing();
+
+  if (failures != 0) {
+    printf("\n%d check(s) failed\n", failures);
+    return 1;
+  }
+
+  printf("\nall checks passed\n");
+  return 0;
+}
