+/***** CAN diagnostics *****/
+#define CAN_ALERT_REPEAT_LOG_MS 5000  // re-log a still-active alert this often
+#define CAN_STATUS_POLL_MS 1000       // controller counter sampling period
+
+typedef struct {
+  TickType_t last_poll;
+  bool valid;
+  uint32_t state;
+  uint32_t tec;
+  uint32_t rec;
+  uint32_t bus_error;
+  uint32_t rx_missed;
+  uint32_t rx_overrun;
+} can_status_snapshot_t;
+
+/* task_can is the only user. Keeping the diagnostic state at file scope leaves
+ * the task's local declarations untouched, which the TEM snapshot patch also
+ * edits, so the two patches stay independent. */
+static can_status_snapshot_t can_status;
+static uint32_t can_alert_repeat;
+static TickType_t can_alert_log_time;
+
+/* Report controller counters, and only what actually moved.
+ *
+ * A dead RX line and a wrong bitrate look identical from outside: no frames
+ * arrive either way. They differ here. A disconnected RX only raises
+ * tx_error_counter, because our own frames never get acknowledged, while
+ * rx_error_counter and bus_error_count stay at zero. A bitrate mismatch does
+ * the opposite: the controller sees edges but cannot decode them, so
+ * rx_error_counter and bus_error_count climb. Without these numbers the two
+ * cases are indistinguishable in the log. */
+static void can_report_status(can_status_snapshot_t *snap) {
+  TickType_t now = xTaskGetTickCount();
+
+  if (snap->valid && (now - snap->last_poll) < pdMS_TO_TICKS(CAN_STATUS_POLL_MS)) {
+    return;
+  }
+
+  snap->last_poll = now;
+
+  twai_status_info_t st;
+
+  if (twai_get_status_info(&st) != ESP_OK) {
+    return;
+  }
+
+  bool first = !snap->valid;
+  char buf[sizeof(system_event_t)];
+
+  /* Stay silent while nothing changes. This task runs for the whole trip and
+   * every syslog line is kept on SD and on the server. */
+  if (first || (uint32_t)st.state != snap->state || st.tx_error_counter != snap->tec ||
+      st.rx_error_counter != snap->rec) {
+    snprintf(buf, sizeof(buf), "CANEC:%02lX/%02lX/%d", (unsigned long)st.tx_error_counter,
+      (unsigned long)st.rx_error_counter, (int)st.state);
+    SYSLOG(buf);
+  }
+
+  if (first || st.bus_error_count != snap->bus_error) {
+    snprintf(buf, sizeof(buf), "CANBE:%lX", (unsigned long)st.bus_error_count);
+    SYSLOG(buf);
+  }
+
+  if (first || st.rx_missed_count != snap->rx_missed) {
+    snprintf(buf, sizeof(buf), "CANMS:%lX", (unsigned long)st.rx_missed_count);
+    SYSLOG(buf);
+  }
+
+  if (first || st.rx_overrun_count != snap->rx_overrun) {
+    snprintf(buf, sizeof(buf), "CANOV:%lX", (unsigned long)st.rx_overrun_count);
+    SYSLOG(buf);
+  }
+
+  snap->valid      = true;
+  snap->state      = (uint32_t)st.state;
+  snap->tec        = st.tx_error_counter;
+  snap->rec        = st.rx_error_counter;
+  snap->bus_error  = st.bus_error_count;
+  snap->rx_missed  = st.rx_missed_count;
+  snap->rx_overrun = st.rx_overrun_count;
+}
 
