diff --git a/device/firmware/main/peripheral/can_live_policy.h b/device/firmware/main/peripheral/can_live_policy.h
new file mode 100644
index 0000000..5bb0209
--- /dev/null
+++ b/device/firmware/main/peripheral/can_live_policy.h
@@ -0,0 +1,23 @@
+#ifndef MONOLITH_CAN_LIVE_POLICY_H
+#define MONOLITH_CAN_LIVE_POLICY_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Orion TEM module 1, individual thermistor broadcast (29-bit CAN ID). */
+#define CAN_ID_ORION_TEM1_THERMISTOR 0x1838F380UL
+
+static inline bool can_live_bypasses_interval(
+  uint32_t id, bool extended, bool remote, uint8_t dlc
+) {
+  return extended && !remote && dlc == 8U && id == CAN_ID_ORION_TEM1_THERMISTOR;
+}
+
+static inline bool can_live_should_forward(
+  uint32_t id, bool extended, bool remote, uint8_t dlc,
+  uint32_t elapsed_ticks, uint32_t interval_ticks
+) {
+  return can_live_bypasses_interval(id, extended, remote, dlc) || elapsed_ticks >= interval_ticks;
+}
+
+#endif
diff --git a/device/firmware/test/test_can_live_policy.c b/device/firmware/test/test_can_live_policy.c
new file mode 100644
index 0000000..5dbd597
--- /dev/null
+++ b/device/firmware/test/test_can_live_policy.c
@@ -0,0 +1,27 @@
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "../main/peripheral/can_live_policy.h"
+
+int main(void) {
+  const uint32_t interval_ticks = 500U;
+
+  /* Only the requested 29-bit TEM individual-temperature frame bypasses. */
+  assert(can_live_should_forward(0x1838F380UL, true, false, 8U, 0U, interval_ticks));
+  assert(!can_live_should_forward(0x1838F380UL, false, false, 8U, 0U, interval_ticks));
+  assert(!can_live_should_forward(0x1838F380UL, true, true, 8U, 0U, interval_ticks));
+  assert(!can_live_should_forward(0x1838F380UL, true, false, 7U, 0U, interval_ticks));
+  assert(!can_live_should_forward(0x1839F380UL, true, false, 8U, 0U, interval_ticks));
+  assert(!can_live_should_forward(0x1838F381UL, true, false, 8U, 0U, interval_ticks));
+
+  /* Existing interval behavior is unchanged for every other CAN frame. */
+  assert(!can_live_should_forward(0x000007A0UL, false, false, 8U, 499U, interval_ticks));
+  assert(can_live_should_forward(0x000007A0UL, false, false, 8U, 500U, interval_ticks));
+  assert(!can_live_should_forward(0x1839F380UL, true, false, 8U, 499U, interval_ticks));
+  assert(can_live_should_forward(0x1839F380UL, true, false, 8U, 500U, interval_ticks));
+  assert(can_live_should_forward(0x1838F380UL, true, true, 8U, 500U, interval_ticks));
+  assert(can_live_should_forward(0x1838F380UL, true, false, 7U, 500U, interval_ticks));
+
+  return 0;
+}
