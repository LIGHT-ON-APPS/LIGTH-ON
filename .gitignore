# STM32CubeIDE build output
Debug/
Release/
Debug_RAM/
Release_RAM/
Debug_FLASH/
Release_FLASH/

# TouchGFX simulator/build output (generated source under TouchGFX/generated is kept)
**/TouchGFX/build/

# TouchGFX incremental generator cache and tool backups
**/TouchGFX/generated/**/cache/
*.bak

# Eclipse / STM32CubeIDE workspace cache
.metadata/
**/.settings/language.settings.xml
*.pdom

# Local headless STM32CubeIDE workspaces
/.cubeide_*/

# Local editor and operating-system files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Local SSH credentials (never commit)
/ssh-key-*.key
/.ssh/
/.oracle_known_hosts
